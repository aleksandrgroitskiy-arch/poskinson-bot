# Ключи Discord-бота. Вставь значения после "=" без кавычек и пробелов, сохрани (Ctrl+S).
# Этот файл никому не показывай и не скринь.

# Discord: https://discord.com/developers/applications → твоё приложение → Bot → Reset Token
DISCORD_TOKEN=

# Gemini: https://aistudio.google.com/apikey → Create API key
GEMINI_API_KEY=

# (необязательно, запасной) Groq: https://console.groq.com/keys → Create API Key
GROQ_API_KEY=

# Имя бота (как он себя называет)
BOT_NAME=poskinson

# ===== Дополнительные бесплатные нейросети (всё необязательно — что заполнишь, то бот и подключит) =====

# OpenRouter — много бесплатных моделей, есть видящие картинки. ~50 запросов/день бесплатно.
# https://openrouter.ai/settings/keys → Create Key
OPENROUTER_API_KEY=

# GitHub Models — ЗАКРЫТ 30.07.2026, не используется (токен можно удалить на github.com/settings/tokens)
# https://github.com/settings/personal-access-tokens/new → Fine-grained token,
# Repository access: Public repositories, Permissions → Account → Models: Read-only
GITHUB_MODELS_TOKEN=

# NVIDIA NIM — десятки моделей бесплатно (с лимитом запросов в минуту).
# https://build.nvidia.com/settings/api-keys → Generate API Key
NVIDIA_API_KEY=

# Cerebras — очень быстрый, ~1 млн токенов/день. Может не пускать из РФ — попробуй.
# https://cloud.cerebras.ai → API Keys
CEREBRAS_API_KEY=

# Cloudflare Workers AI — генерация картинок получше (FLUX). Нужны оба поля.
# https://dash.cloudflare.com → справа Account ID (скопировать);
# My Profile → API Tokens → Create Token → шаблон «Workers AI»
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Klipy — гифки (замена закрытого Tenor). https://partner.klipy.com → получить API key
KLIPY_API_KEY=

# ===== Ещё бесплатные нейросети (2026-10-02) =====
# Z.ai — GLM-4.7-Flash и GLM-4.6V-Flash (видит картинки) бесплатно, без карты. Вход через Google.
# https://z.ai → войти → справа сверху профиль → API Keys → Create a new API key
ZAI_API_KEY=

# SambaNova — DeepSeek V3.1/V3.2, Llama 3.3 70B, gpt-oss-120b. Бесплатно, пока НЕ привязываешь оплату (ничего не вводи).
# https://cloud.sambanova.ai → войти → APIs / API Keys → Generate
SAMBANOVA_API_KEY=

# Mistral — бесплатный тариф Experiment (Mistral Medium/Small). Попросит подтвердить телефон — может не принять РФ-номер.
# https://console.mistral.ai → Choose a plan → Experiment (free) → API Keys → Create new key
MISTRAL_API_KEY=
